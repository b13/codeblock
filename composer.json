{
	"name": "b13/codeblock",
	"type": "typo3-cms-extension",
	"description": "Custom content type for displaying source code with syntax highlighting in TYPO3.",
	"homepage": "https://github.com/b13/codeblock",
	"license": ["GPL-2.0-or-later"],
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^13.4 || ^14.0",
		"typo3/cms-backend": "^13.4 || ^14.0",
		"typo3/cms-frontend": "^13.4 || ^14.0",
		"scrivo/highlight.php": "^9.15"
	},
	"require-dev": {
		"typo3/tailor": "^1.5"
	},
	"autoload": {
		"psr-4": {
			"B13\\Codeblock\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "codeblock"
		}
	},
	"support": {
		"issues": "https://github.com/b13/codeblock/issues"
	}
}
